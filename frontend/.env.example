VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=/api
# Paystack public key. Required for the Pro upgrade checkout.
VITE_PAYSTACK_PUBLIC_KEY=
# Web push public VAPID key. Use the public key only, never the private key.
VITE_VAPID_PUBLIC_KEY=
# Optional comma-separated owner addresses for the website admin at /adb.
# Add the same addresses to public.site_admins before expecting writes to save.
VITE_SITE_ADMIN_EMAILS=
