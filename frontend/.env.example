# Frontend Environment Configuration
# Located: /frontend/.env
# Copy from /frontend/.env.example and fill in actual values
# These are prefixed with VITE_ to be accessible in Vite builds

# Supabase Configuration
# Get these from: https://app.supabase.com/projects
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend API Configuration
VITE_API_URL=http://localhost:5000
VITE_API_TIMEOUT=30000

# Environment
VITE_NODE_ENV=development

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_QR_GENERATION=true

# External Services
VITE_STRIPE_PUBLIC_KEY=pk_test_...  # If using Stripe

# App Configuration
VITE_APP_NAME=Selorah Health
VITE_APP_DESCRIPTION=Your health story, everywhere you go
