# Backend Environment Configuration
# Located: /backend/.env
# Copy from /backend/.env.example and fill in actual values

# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# Supabase Configuration
# Get these from: https://app.supabase.com/projects
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Socket.io Configuration
SOCKET_PORT=5000
SOCKET_CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Connection (optional, if direct PostgreSQL access needed)
DATABASE_URL=postgresql://user:password@localhost:5432/selorah

# JWT Secret (for additional token signing if needed)
JWT_SECRET=your_super_secret_jwt_key_here

# Email Configuration (for sending notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_app_password

# Blockchain Configuration
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
BLOCKCHAIN_CONTRACT_ADDRESS=0x...

# API Keys (Third-party services)
STRIPE_KEY=sk_test_...  # If using Stripe for payments
AWS_S3_BUCKET=selorah-records
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Logging
SENTRY_DSN=https://key@sentry.io/project_id  # Error tracking

# Feature Flags
ENABLE_QR_SHARING=true
ENABLE_BLOCKCHAIN_VERIFICATION=true
ENABLE_REAL_TIME_SYNC=true
