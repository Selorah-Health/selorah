# Blockchain Environment Configuration
# Located: /blockchain/.env
# Copy from /blockchain/.env.example and fill in actual values

# Network Configuration - Monad Testnet
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_TESTNET_CHAIN_ID=10143
MONAD_TESTNET_EXPLORER=https://testnet.monadexplorer.com

# Wallet Configuration
# PRIVATE_KEY: Your wallet's private key (keep secure!)
# ⚠️ NEVER commit this to version control
# ⚠️ Use environment variables or secret management in production
PRIVATE_KEY=0x...

# Deployment Configuration
DEPLOYMENT_GAS_LIMIT=3000000
DEPLOYMENT_GAS_PRICE=1000000000  # 1 Gwei

# Contract Configuration
CONTRACT_OWNER_ADDRESS=0x...  # Address that will own the contracts

# Testnet Faucet Information
MONAD_FAUCET_URL=https://faucet.monad.xyz
TESTNET_TOKEN_NAME=MON  # Monad test tokens

# Hardhat Configuration
HARDHAT_NETWORK=monadTestnet
SOLIDITY_VERSION=0.8.24

# Verification (optional, for block explorer)
ETHERSCAN_API_KEY=  # If block explorer requires API key

# Development/Testing
ENABLE_DEBUG_MODE=false
VERBOSE_LOGGING=true
